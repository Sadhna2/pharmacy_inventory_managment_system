# --- Database ---
# Project-local cluster started by ./scripts/db.sh (port 55432, never the default 5432)
DATABASE_URL=postgresql+psycopg://pharmacy@/pharmacy?host=/tmp&port=55432

# --- Security ---
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Seed ---
# Password for the four demo accounts. Set this before running the seed; it is
# deliberately absent from the repository. Seeding with the built-in fallback is
# refused unless ENV=development.
SEED_PASSWORD=

# --- Seller identity (GST) ---
# Printed on every tax invoice, and the fallback for a branch with no
# registration of its own. Without these the invoice route refuses outright:
# rule 46(b) makes the supplier's GSTIN mandatory, so a document captioned
# TAX INVOICE without one is not a tax invoice.
#
# These live here as well as in the repository root's .env because the two are
# read by different things — compose reads the root, and `uvicorn` run from
# this directory reads this one. A developer who set up only this file got an
# API that could not print an invoice, and no obvious reason why.
SELLER_LEGAL_NAME="Sadhna Pharma Distributors Pvt Ltd"
SELLER_GSTIN="27AABCS9876P1ZA"
SELLER_ADDRESS="Unit 4, MIDC Phase II, Bhiwandi 421302"

# --- App ---
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Layer 2 (AI) — not required for Layer 0/1 ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# SENTRY_DSN=
