# --- Database ---
# Project-local cluster started by ./scripts/db.sh (port 55432, never the default 5432)
DATABASE_URL=postgresql+psycopg://pharmacy@/pharmacy?host=/tmp&port=55432

# --- Security ---
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Seed ---
# Password for the four demo accounts. Set this before running the seed; it is
# deliberately absent from the repository. Seeding with the built-in fallback is
# refused unless ENV=development.
SEED_PASSWORD=

# --- App ---
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Layer 2 (AI) — not required for Layer 0/1 ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# SENTRY_DSN=
