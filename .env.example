# Copy this to `.env` and the whole stack picks it up automatically:
#
#     cp .env.example .env
#
# `.env` is gitignored. Real passwords never go in this file — this one is
# committed, so it holds only local-development values that are safe to publish.

# --- database ---------------------------------------------------------------
# Local only. The database port is never published outside Docker, so this is
# not reachable from anywhere but the other containers.
POSTGRES_PASSWORD=localdev

# --- application ------------------------------------------------------------
# Signs login tokens. Fine for a laptop; production uses a long random value.
SECRET_KEY=dev-only-change-me-in-production

# The password given to every demo account created by the seed script
# (admin@pharmacy.co.in, manager@..., staff@...). Change it and re-seed to
# change them all.
#
# This deliberately matches the fallback the seed uses when SEED_PASSWORD is
# unset, so that `docker compose up` and `cp .env.example .env && docker
# compose up` put you in front of the *same* login. It used to read
# "change-me-before-first-seed", which meant following the README to the
# letter produced a password the README never mentioned — you reached the
# sign-in page and could not get past it.
#
# It is safe to publish: it only ever unlocks synthetic demo data on a laptop.
# The seed refuses to run with this value unless ENV=development.
SEED_PASSWORD=ChangeMe@123

ENV=development
LOG_LEVEL=INFO

# --- invoice scanning -------------------------------------------------------
# Reads a supplier invoice photograph into a draft goods receipt
# (app/ai/intake). The only outbound call the system makes.
#
# Leave it empty and the feature switches itself off: the endpoint answers 503
# and everything else works normally. Get a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Replay stored extractions from this directory instead of calling the API.
# For demos — a conference network should not be able to break a presentation —
# and for tests, which must never need a key or make a network call.
#
# Four recorded invoices ship with the repository. Set this to
#     fixtures/intake
# and the scan works with no key and no uplink. Only the transcription is
# replayed: the arithmetic checks, the GSTIN checksum and the product matching
# all still run, because none of them ever made a network call.
# See api/fixtures/intake/README.md.
INTAKE_FIXTURE_DIR=

# --- web --------------------------------------------------------------------
# Where the site answers on your machine. Change WEB_PORT if 8080 is taken.
WEB_PORT=8080
WEB_TLS_PORT=8443
CORS_ORIGINS=http://localhost:8080

# --- time --------------------------------------------------------------------
# Business dates are pinned to Asia/Kolkata in app/core/clock.py and do not
# depend on this. It aligns container logs with the app's own reckoning.
TZ=Asia/Kolkata
