# Copy this to `.env` and the whole stack picks it up automatically:
#
#     cp .env.example .env
#
# `.env` is gitignored. Real passwords never go in this file — this one is
# committed, so it holds only local-development values that are safe to publish.

# --- database ---------------------------------------------------------------
# Local only. The database port is never published outside Docker, so this is
# not reachable from anywhere but the other containers.
POSTGRES_PASSWORD=localdev

# --- application ------------------------------------------------------------
# Signs login tokens. Fine for a laptop; production uses a long random value.
SECRET_KEY=dev-only-change-me-in-production

# The password given to every demo account created by the seed script
# (admin@pharmacy.co.in, manager@..., staff@...). Change it and re-seed to
# change them all.
SEED_PASSWORD=change-me-before-first-seed

ENV=development
LOG_LEVEL=INFO

# --- web --------------------------------------------------------------------
# Where the site answers on your machine. Change WEB_PORT if 8080 is taken.
WEB_PORT=8080
WEB_TLS_PORT=8443
CORS_ORIGINS=http://localhost:8080
